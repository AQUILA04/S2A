# ============================================================
# Amicale S2A — Production environment (Contabo VPS)
# ============================================================
# Copy to deploy/.env.prod on the server (never commit).
# CI/CD writes this file from GitHub Actions secrets on deploy.
# ============================================================

# ---- Public URL (must match Traefik host + NEXTAUTH_URL) ----
APP_HOST=s2a.optimizesolux.com
NEXTAUTH_URL=https://s2a.optimizesolux.com

# ---- Supabase (cloud — same project as dev or dedicated prod) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---- NextAuth ----
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_REPLACE_ME

# ---- Notification Hub (OTP activation — required in prod) ----
NOTIFICATION_HUB_BASE_URL=https://notification-api.optimizesolux.com
NOTIFICATION_HUB_TENANT_ID=s2a
NOTIFICATION_HUB_OAUTH_ENABLED=true
NOTIFICATION_HUB_OAUTH_TOKEN_URI=https://auth.optimizesolux.com/realms/notification-hub/protocol/openid-connect/token
NOTIFICATION_HUB_OAUTH_CLIENT_ID=s2a
NOTIFICATION_HUB_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET

# ---- Docker image (set by CD or manually) ----
# IMAGE=ghcr.io/aquila04/s2a:latest
