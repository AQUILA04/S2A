# ============================================================
# Amicale S2A - Environment Variables
# ============================================================
# IMPORTANT: Never commit this file to version control!
# Copy this file to .env.local and fill in the actual values.
# ============================================================

# ---- Supabase ----
# Find these in the Supabase dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---- NextAuth.js ----
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_REPLACE_ME
NEXTAUTH_URL=http://localhost:3000

# ---- Production (Contabo) ----
# See deploy/.env.prod.example and deploy/README.md
# APP_HOST=s2a.optimizesolux.com
# NEXTAUTH_URL=https://s2a.optimizesolux.com  (must match APP_HOST with https)

# ---- Seed Script (optional) ----
# Override the default GS initial password used by scripts/seed.ts
# GS_SEED_PASSWORD=Change-Me-Now-2026!

# ---- Notification Hub (OTP account activation) ----
# Dev local (hub profile local, no OAuth)
NOTIFICATION_HUB_BASE_URL=http://localhost:8088
NOTIFICATION_HUB_TENANT_ID=s2a
NOTIFICATION_HUB_OAUTH_ENABLED=false

# Prod Contabo
# NOTIFICATION_HUB_BASE_URL=https://notification-api.optimizesolux.com
# NOTIFICATION_HUB_OAUTH_ENABLED=true
# NOTIFICATION_HUB_OAUTH_TOKEN_URI=https://auth.optimizesolux.com/realms/notification-hub/protocol/openid-connect/token
# NOTIFICATION_HUB_OAUTH_CLIENT_ID=s2a
# NOTIFICATION_HUB_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
